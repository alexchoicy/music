<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <SixLaborsLicenseKey Condition="'$(SixLaborsLicenseKey)' == ''"
      >$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey
    >
    <SixLaborsLicenseFile Condition="'$(SixLaborsLicenseFile)' == ''"
      >$(MSBuildThisFileDirectory)sixlabors.lic</SixLaborsLicenseFile
    >
  </PropertyGroup>
  <ItemGroup>
    <!-- API -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />

    <!-- Infrastructure -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.5" />
    <PackageVersion Include="Blake3.Native" Version="3.0.2" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>
</Project>
