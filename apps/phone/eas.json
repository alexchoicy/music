{
	"cli": {
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": { "APP_VARIANT": "development" }
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"APP_VARIANT": "production",
				"ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
			},
			"android": { "buildType": "apk" }
		}
	}
}
